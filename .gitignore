# ============================================================
# Customer Support & Ticket Management Platform
# .gitignore
# ============================================================

# ── OS & Editor ───────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Environment Variables ─────────────────────────────────
.env
.env.local
.env.development
.env.test
.env.production
.env.staging
!.env.example
!.env.example.*

# ── Node.js ───────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/

# ── Backend specific ──────────────────────────────────────
backend/logs/
backend/uploads/
backend/server_out.txt
backend/coverage/
backend/dist/

# ── Frontend specific ─────────────────────────────────────
frontend/dist/
frontend/build/
frontend/coverage/
frontend/.vite/

# ── Logs ─────────────────────────────────────────────────
logs/
*.log
*.log.*

# ── Build outputs ─────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/

# ── Testing & Coverage ────────────────────────────────────
coverage/
.nyc_output/
*.lcov
junit.xml
test-results/
playwright-report/

# ── Package manager locks (keep one) ──────────────────────
# Keep package-lock.json, ignore others
yarn.lock
pnpm-lock.yaml

# ── Uploads & User files ──────────────────────────────────
uploads/
tmp/
temp/

# ── Docker ────────────────────────────────────────────────
.docker/

# ── Miscellaneous ─────────────────────────────────────────
*.bak
*.tmp
*.orig
*.pid
*.seed
*.pid.lock
*.tgz
